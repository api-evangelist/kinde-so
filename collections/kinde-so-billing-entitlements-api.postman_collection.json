          "name": "Get billing entitlements",
          "request": {
            "name": "Get billing entitlements",
            "description": {
              "content": "Returns all the entitlements a billing customer currently has access to\n\n<div>\n  <code>read:billing_entitlements</code>\n</div>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "billing",
                "entitlements"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "Number of results per page. Defaults to 10 if parameter not sent."
                },
                {
                  "disabled": false,
                  "key": "starting_after",
                  "value": "<string>",
                  "description": "The ID of the billing entitlement to start after."
                },
                {
                  "disabled": false,
                  "key": "ending_before",
                  "value": "<string>",
                  "description": "The ID of the billing entitlement to end before."
                },
                {
                  "disabled": false,
                  "key": "customer_id",
                  "value": "<string>",
                  "description": "(Required) The ID of the billing customer to retrieve entitlements for"
                },
                {
                  "disabled": false,
                  "key": "max_value",
                  "value": "<string>",
                  "description": "When the maximum limit of an entitlement is null, this value is returned as the maximum limit"
                },
                {
                  "disabled": false,
                  "key": "expand",
                  "value": "<string>",
                  "description": "Additional plan data to include in the response. Allowed value: \"plans\"."
                }
              ],
              "variable": [
                {
                  "description": "The subdomain generated for your business on Kinde.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
