        {
          "id": "a4cc5c66-39f3-47b2-b7f0-c0c5b58b5e58",
          "name": "Get Connected App URL",
          "request": {
            "name": "Get Connected App URL",
            "description": {
              "content": "Get a URL that authenticates and authorizes a user to a third-party connected app.\n\n<div>\n  <code>read:connected_apps</code>\n</div>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "connected_apps",
                "auth_url"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key_code_ref",
                  "value": "<string>",
                  "description": "(Required) The unique key code reference of the connected app to authenticate against."
                },
                {
                  "disabled": false,
                  "key": "user_id",
                  "value": "<string>",
                  "description": "The id of the user that needs to authenticate to the third-party connected app."
                },
                {
                  "disabled": false,
                  "key": "org_code",
                  "value": "<string>",
                  "description": "The code of the Kinde organization that needs to authenticate to the third-party connected app."
                },
                {
                  "disabled": false,
                  "key": "override_callback_url",
                  "value": "<string>",
                  "description": "A URL that overrides the default callback URL setup in your connected app configuration"
                }
              ],
              "variable": [
                {
                  "description": "The subdomain generated for your business on Kinde.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
