{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kinde Management API Keys Business API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Business",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get business",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.kinde.com/api/v1/business",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get your business details.\n\n<div>\n  <code>read:businesses</code>\n</div>"
        },
        {
          "info": {
            "name": "Update business",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{subdomain}.kinde.com/api/v1/business",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update your business details.\n\n<div>\n  <code>update:businesses</code>\n</div>"
        }
      ]
    }
  ],
  "bundled": true
}