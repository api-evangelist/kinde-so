          "name": "Get billing agreements",
          "request": {
            "name": "Get billing agreements",
            "description": {
              "content": "Returns all the agreements a billing customer currently has access to\n\n<div>\n  <code>read:billing_agreements</code>\n</div>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "billing",
                "agreements"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "Number of results per page. Defaults to 10 if parameter not sent."
                },
                {
                  "disabled": false,
                  "key": "starting_after",
                  "value": "<string>",
                  "description": "The ID of the billing agreement to start after."
                },
                {
                  "disabled": false,
                  "key": "ending_before",
                  "value": "<string>",
                  "description": "The ID of the billing agreement to end before."
                },
                {
                  "disabled": false,
                  "key": "customer_id",
                  "value": "<string>",
                  "description": "(Required) The ID of the billing customer to retrieve agreements for"
                },
                {
                  "disabled": false,
                  "key": "feature_code",
                  "value": "<string>",
                  "description": "The feature code to filter by agreements only containing that feature"
                }
              ],
              "variable": [
                {
                  "description": "The subdomain generated for your business on Kinde.",
