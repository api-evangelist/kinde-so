          "name": "Search users",
          "request": {
            "name": "Search users",
            "description": {
              "content": "Search for users based on the provided query string. Set query to '*' to filter by other parameters only.\nThe number of records to return at a time can be controlled using the `page_size` query string parameter.\n\n<div>\n  <code>read:users</code>\n</div>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "search",
                "users"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "Number of results per page. Defaults to 10 if parameter not sent."
                },
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "Search the users by email or name. Use '*' to search all."
                },
                {
                  "disabled": false,
                  "key": "api_scopes",
                  "value": "<string>",
                  "description": "Search the users by api scopes."
                },
                {
                  "disabled": false,
                  "key": "starting_after",
                  "value": "<string>",
                  "description": "The ID of the user to start after."
                },
                {
                  "disabled": false,
                  "key": "ending_before",
                  "value": "<string>",
                  "description": "The ID of the user to end before."
                },
                {
                  "disabled": false,
                  "key": "expand",
                  "value": "<string>",
                  "description": "Additional data to include in the response. One or more of (comma-separated): \"organizations\", \"identities\", \"properties\"."
                }
              ],
              "variable": [
                {
                  "description": "The subdomain generated for your business on Kinde.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
