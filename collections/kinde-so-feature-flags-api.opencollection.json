{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kinde Management API Keys Feature Flags API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Feature Flags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Feature Flag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.kinde.com/api/v1/feature_flags",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create feature flag.\n\n<div>\n  <code>create:feature_flags</code>\n</div>"
        },
        {
          "info": {
            "name": "Replace Feature Flag",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{subdomain}.kinde.com/api/v1/feature_flags/:feature_flag_key",
            "params": [
              {
                "name": "feature_flag_key",
                "value": "",
                "type": "path",
                "description": "The key identifier for the feature flag."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "The name of the flag."
              },
              {
                "name": "description",
                "value": "",
                "type": "query",
                "description": "Description of the flag purpose."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "The variable type"
              },
              {
                "name": "allow_override_level",
                "value": "",
                "type": "query",
                "description": "Allow the flag to be overridden at a different level."
              },
              {
                "name": "default_value",
                "value": "",
                "type": "query",
                "description": "Default value for the flag used by environments and organizations."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update feature flag.\n\n<div>\n  <code>update:feature_flags</code>\n</div>"
        },
        {
          "info": {
            "name": "Delete Feature Flag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{subdomain}.kinde.com/api/v1/feature_flags/:feature_flag_key",
            "params": [
              {
                "name": "feature_flag_key",
                "value": "",
                "type": "path",
                "description": "The identifier for the feature flag."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete feature flag\n\n<div>\n  <code>delete:feature_flags</code>\n</div>"
        }
      ]
    }
  ],
  "bundled": true
}